# Copy to .env (gitignored). Nothing here is required to run the web app.

# SQLite database file used by the app and the pipeline
SOMMELIER_DB=sommelier.db

# LLM backends (pipeline only, never the web app)
# Judge + generator go through the Claude Code CLI on your subscription.
# Path to claude.exe if it is not on PATH:
# SOMMELIER_CLAUDE_BIN=C:\path\to\claude.exe
SOMMELIER_GEN_MODEL=opus
SOMMELIER_JUDGE_MODEL=sonnet
# Critic goes through OpenRouter (independent model family)
OPENROUTER_API_KEY=
SOMMELIER_CRITIC_MODEL=deepseek/deepseek-chat
# Hard cap on LLM calls per pipeline run (cache hits are free)
SOMMELIER_MAX_LLM_CALLS=400

# Optional; falls back to `gh auth token`
GITHUB_TOKEN=
